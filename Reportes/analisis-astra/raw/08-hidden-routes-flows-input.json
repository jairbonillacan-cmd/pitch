    },
    {
      "step_id": "goto-match-1570024",
      "timeout_ms": 15000,
      "action": "goto",
      "destination": {
        "url": "https://astraanalisis.com/",
        "query": [
          {
            "name": "partido",
            "value": {
              "source": "literal",
              "value": "1570024"
            }
