{
  "name": "@pitchlab/spacetime",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./data/*": "./data/*"
  },
  "scripts": {
    "sync": "node scripts/sync-from-prediction-lab.mjs",
    "sync:data": "node scripts/sync-from-prediction-lab.mjs --data-only",
