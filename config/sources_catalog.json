{
  "schema_version": "1.0.0",
  "engine": {
    "library": "scrapling",
    "min_version": "0.5.1",
    "venv_path": ".worktrees/web-scraping/.venv",
    "skill_path": "Scrapling/agent-skill/Scrapling-Skill/SKILL.md",
    "strict_rules": {
      "exclusive_scrapling_only": true,
      "prohibited_libraries": [
        "requests",
        "urllib",
        "httpx",
        "curl",
        "beautifulsoup4_standalone",
        "playwright_standalone"
      ],
      "cli_require_ai_targeted": true,
      "require_captured_at_utc": true,
      "require_sha256_manifest": true,
      "anti_leakage_rule": "captured_at_utc <= predicted_at_utc"
    }
  },
  "categories": [
    {
      "id": "odds_casinos",
      "name": "Casinos, Casas de Apuestas y Agregadores de Cuotas",
      "description": "Líneas de apertura, movimientos intra-semana (steam moves), cierre real (T-60m y T-5m), dispersión entre casas y probabilidad justa sin vig."
    },
    {
      "id": "advanced_stats_xg",
      "name": "Sitios de Datos Estadísticos Avanzados (xG, Opta, Jugadores, Boxscores)",
      "description": "Estadísticas granulares por partido y jugador (xG, xA, xP, xGOT, PSxG, PPDA, eventos Opta) para Liga MX, ligas europeas y NFL."
    },
    {
      "id": "injuries_lineups",
      "name": "Sitios de Lesiones, Suspensiones y Alineaciones",
      "description": "Disponibilidad de plantilla, valor de mercado ausente (€), partes médicos oficiales y alineaciones probables (T-24h) y confirmadas (T-60m)."
    },
    {
      "id": "news_press_sentiment",
      "name": "Sitios de Noticias Deportivas, Ruedas de Prensa y Contexto de Vestuario",
      "description": "Señales cualitativas entre semana: ruedas de prensa de entrenadores, rotaciones por copas, cambios de DT y reportes de campamento."
    },
    {
      "id": "environment_referees",
      "name": "Contexto Ambiental, Estadios y Arbitraje",
      "description": "Variables exógenas previas al kickoff: viento/clima horario en estadios abiertos, altitud y estadísticas históricas del árbitro designado."
    }
  ],
