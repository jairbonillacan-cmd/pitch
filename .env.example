# Código de acceso de 4 dígitos para revisión previa local sin cuentas (vacío en producción con cuentas activas)
PITCHLAB_BETA_CODE=

# Secreto HMAC-SHA256 aleatorio (>= 32 caracteres) para firmar la cookie HttpOnly de beta si se usa localmente (p. ej. openssl rand -hex 32)
PITCHLAB_COOKIE_SECRET=

# Opcional: clave gratuita de API-Football (api-football.com) para habilitar Liga MX (máx. 100 solicitudes/día)
API_FOOTBALL_KEY=

# Opcional: clave gratuita de football-data.org (X-Auth-Token) para Premier League
FOOTBALL_DATA_API_KEY=

# Herramientas de revisión (selector de rol, barra de 11 vistas) en producción. Vacío = apagadas.
PITCHLAB_PREVIEW_TOOLS=

# Antigüedad máxima de los momios de Spacetime v3.0 para mostrarlos como vigentes (horas).
PITCHLAB_MAX_ODDS_AGE_HOURS=72

# --- F4 (los crea y carga el fundador; ver docs/architecture/DEPLOYMENT.md §6) ---
# PostgreSQL de Neon. Esquema y migraciones en packages/db (pnpm --filter @pitchlab/db migrate).
DATABASE_URL=

# Better Auth (ADR-010): /api/auth/*. Secreto aleatorio de 32+ caracteres.
# En producción BETTER_AUTH_URL=https://pitchlab.mx (el inicio de sesión solo funciona en ese dominio).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Correo del enlace mágico (Resend). Sin clave, en desarrollo el enlace sale en la consola.
RESEND_API_KEY=
AUTH_EMAIL_FROM=PitchLab <acceso@pitchlab.mx>
# Remitente de los demás correos (bienvenida, prueba, avisos). Mismo dominio verificado en Resend.
EMAIL_FROM=PitchLab <hola@pitchlab.mx>
# Correo de soporte que aparece en el pie de todos los correos.
PITCHLAB_SUPPORT_EMAIL=soporte@pitchlab.mx
# Inicio de sesión con Google (opcional). Apple no se usa: su programa de desarrollador cobra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Conectar la cuenta de X en el perfil (opcional; sin ellas el botón dice «Pronto»).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# Foto de perfil en Vercel Blob (opcional; sin ella el botón en Editar perfil dice «Pronto»).
BLOB_READ_WRITE_TOKEN=
# Opcional: URL pública del logo en los correos (por defecto, el de pitchlab.mx).
EMAIL_LOGO_URL=

# Cloudflare Turnstile (escudo anti-abuso del enlace mágico). Van las dos o ninguna:
# la pública la usa el navegador y la secreta la verifica el servidor.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Modo de cobro activo en Beta 1.0 ("transfer" = SPEI + cupones manuales; "stripe" = Stripe Checkout + Connect).
PITCHLAB_PAYMENTS_MODE=transfer
# Datos bancarios SPEI visibles al crear o consultar una solicitud de transferencia.
PITCHLAB_TRANSFER_BANK=
PITCHLAB_TRANSFER_BENEFICIARY=
PITCHLAB_TRANSFER_CLABE=
# Nota opcional con horarios o instrucciones adicionales para validar el comprobante SPEI.
PITCHLAB_TRANSFER_INSTRUCTIONS=

# Stripe MX: /api/webhooks/stripe (eventos de suscripción, cobro y reembolso).
# Crea el endpoint con la versión de API 2025-09-30.clover (la misma que fija stripe-api.ts) y
# suscríbelo a: customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed, charge.refunded y checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secreto del endpoint de Connect (eventos de cuentas de tipsters, p. ej. account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Secreto con el que Vercel Cron llama a /api/cron/tipster-payouts (pagos diarios a tipsters y recordatorios por correo).
CRON_SECRET=
# IDs de precio del Pase Total en Stripe (price_...): $299/mes y $2,390/año.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Cupón del amigo invitado: en Stripe, Cupón «$90 MXN de descuento» (amount_off=9000, currency=mxn,
# duration=once) para que su primer mes quede en $209. Se aplica solo en el plan mensual.
STRIPE_COUPON_REFERRAL=

# Correos con acceso a /app/admin (separados por coma).
PITCHLAB_ADMIN_EMAILS=

# Upstash Redis REST (limitador de tasa distribuido y atómico en /api/*; en desarrollo usa memoria).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook HTTPS de despliegue en Vercel (opcional: refresca snapshots en CI tras ingesta).
VERCEL_DEPLOY_HOOK_URL=

# Facturapi (CFDI 4.0; módulo validado, se activa al conectar timbrado fiscal en cobro).
FACTURAPI_KEY=

# Cortex IA (resumen previo con LLM vía OpenRouter, ADR-013). Sin clave se usa la plantilla.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Proveedor fijo de OpenRouter (los precios varían entre proveedores).
OPENROUTER_PROVIDER=

# Desarrollo local con rama aislada de Neon (scripts/local-9990.ps1 y scripts/migrate-9990.ps1).
NEON_PROJECT_ID=
NEON_DATABASE_NAME=neondb
