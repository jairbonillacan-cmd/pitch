# Código de acceso de 4 dígitos para socios en el pre-MVP (comparación en tiempo constante en el servidor)
PREVIEW_ACCESS_CODE=0000

# Secreto HMAC para firmar la cookie HttpOnly de acceso a la beta (mínimo 32 caracteres aleatorios en producción)
BETA_COOKIE_SECRET=reemplazar-con-secreto-aleatorio-de-32-caracteres-minimo

# Opcional: clave gratuita de API-Football para habilitar Liga MX (máx. 100 solicitudes/día)
API_FOOTBALL_KEY=

# Opcional: Upstash Redis para rate limit distribuido en producción (5 intentos / 15 min por IP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: Deploy Hook de Vercel para regenerar tras publicar un snapshot desde GitHub Actions
VERCEL_DEPLOY_HOOK_URL=
