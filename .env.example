# Código de acceso de 4 dígitos para revisión previa local sin cuentas (vacío en producción con cuentas activas)
PITCHLAB_BETA_CODE=

# Secreto HMAC-SHA256 aleatorio (>= 32 caracteres) para firmar la cookie HttpOnly de beta si se usa localmente (p. ej. openssl rand -hex 32)
PITCHLAB_COOKIE_SECRET=

# Opcional: clave gratuita de API-Football (api-football.com) para habilitar Liga MX (máx. 100 solicitudes/día)
API_FOOTBALL_KEY=

# Opcional: clave gratuita de football-data.org (X-Auth-Token) para Premier League
FOOTBALL_DATA_API_KEY=

# Opcional (GitHub Actions · odds-refresh.yml): API oficial The Odds API v4 (plan gratuito 500 req/mes).
# Con BZZOIRO_API_KEY solo se usa para la NFL; el fútbol sale de Bzzoiro.
THE_ODDS_API_KEY=

# Opcional (GitHub Actions · odds-refresh.yml): Betfair Exchange API-NG oficial (Delayed App Key gratuita)
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# --- Proveedores de datos para entrenar y alimentar los motores (services/ingest/src/providers) ---
# Comprobar claves: pnpm --filter @pitchlab/ingest providers:check
# 5DollarFootballAPI (5dollarfootballapi.com). Cabecera: Authorization: Bearer <clave>.
# Free: top 5 de Europa, 60 req/h, 3 meses de historia. Pro US$5: 130+ ligas con Liga MX, 12 meses.
# Ultra US$25: 1,600+ ligas, 20 casas y momios tick a tick desde 2014.
FIVEDOLLAR_FOOTBALL_API_KEY=
# free | community | pro | ultra. En free/community la app debe mostrar «Football data by 5DollarFootballAPI».
FIVEDOLLAR_FOOTBALL_PLAN=free
# Bzzoiro Sports Data (sports.bzzoiro.com). Cabecera: Authorization: Token <clave>.
# También como secreto de GitHub Actions: pre-mvp-snapshot.yml (Elo de xG de la Premier) y odds-refresh.yml
# (momios de las 6 ligas de fútbol por casa: Pinnacle, Bet365, Codere…). Ver docs/research/BZZOIRO_SPORTS_PACK.md.
# Gratis: xG por tiro, alineaciones, bajas, árbitros, predicciones y momio de consenso. US$5: casas por nombre.
BZZOIRO_API_KEY=
# MLB Stats API y NHL Web API: no llevan clave. Uso no comercial salvo licencia (solo entrenar e investigar).
# Pon 0 para apagarlas.
MLB_STATSAPI_ENABLED=1
NHL_API_ENABLED=1
# Identificador honesto del bot en las peticiones (sin correos personales).
PITCHLAB_DATA_USER_AGENT=PitchLab-Bot/1.0 (+https://pitchlab.mx; data-research)

# Herramientas de revisión (selector de rol, barra de 11 vistas) en producción. Vacío = apagadas.
PITCHLAB_PREVIEW_TOOLS=

# Antigüedad máxima de los momios de Spacetime v3.0 para mostrarlos como vigentes (horas).
PITCHLAB_MAX_ODDS_AGE_HOURS=72

# --- F4 · Infraestructura agnóstica de proveedor (ADR-050) ---
# PostgreSQL 15+ estándar (Neon, Supabase, RDS, Cloud SQL, VPS/Docker). Migraciones: pnpm --filter @pitchlab/db migrate.
DATABASE_URL=
# Bandera neutra para marcar cualquier despliegue remoto (VPS/Docker/Coolify/etc.) si la plataforma no inyecta marcador propio.
PITCHLAB_HOSTED=
# Etiqueta opcional devuelta por GET /api/health (ej. "docker", "vps", "fly"). Por defecto autodetecta o usa "node".
PITCHLAB_RUNTIME_LABEL=

# Better Auth (ADR-010): /api/auth/*. Secreto aleatorio de 32+ caracteres.
# En producción BETTER_AUTH_URL=https://pitchlab.mx (el inicio de sesión solo funciona en ese dominio).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Correo del enlace mágico (Resend). Sin clave, en desarrollo el enlace sale en la consola.
RESEND_API_KEY=
AUTH_EMAIL_FROM=PitchLab <acceso@pitchlab.mx>
# Remitente de los demás correos (bienvenida, prueba, avisos). Mismo dominio verificado en Resend.
EMAIL_FROM=PitchLab <hola@pitchlab.mx>
# Remitente sin respuesta para cupones y avisos automáticos de cobro SPEI.
EMAIL_NOREPLY_FROM=PitchLab <noreply@pitchlab.mx>
# Correo de soporte que aparece en el pie de todos los correos.
PITCHLAB_SUPPORT_EMAIL=soporte@pitchlab.mx
# Inicio de sesión con Google (opcional). Apple no se usa: su programa de desarrollador cobra.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Conectar la cuenta de X en el perfil (opcional; sin ellas el botón dice «Pronto»).
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
# --- Almacenamiento de avatares agnóstico de proveedor (ADR-050) ---
# Opcional: forzar adaptador ("s3" | "gcs" | "vercel-blob"). En automático prioriza S3-compatible -> GCS -> Vercel Blob.
AVATAR_STORAGE_PROVIDER=
# Opción 1 (portable · estándar S3 SigV4: AWS S3, Backblaze B2, MinIO, DO Spaces, Hetzner, Tigris, R2):
S3_AVATAR_ENDPOINT=
S3_AVATAR_BUCKET=
S3_AVATAR_REGION=us-east-1
S3_AVATAR_ACCESS_KEY_ID=
S3_AVATAR_SECRET_ACCESS_KEY=
# URL pública base si sirves avatares detrás de tu propio dominio/CDN (también se agrega automáticamente a CSP img-src)
S3_AVATAR_PUBLIC_BASE_URL=
AVATAR_PUBLIC_BASE_URL=
# Orígenes HTTPS adicionales permitidos en CSP img-src (separados por coma) al migrar CDN/media sin tocar código:
PITCHLAB_MEDIA_ORIGINS=
# Opción 2 (adaptador opcional Google Cloud Storage):
GCS_AVATAR_BUCKET=
GCS_AVATAR_PUBLIC_BASE_URL=
# Opción 3 (adaptador opcional Vercel Blob; sin ninguno de los tres el botón dice «Pronto»):
BLOB_READ_WRITE_TOKEN=
# Opcional: URL pública del logo en los correos (por defecto, el de pitchlab.mx).
EMAIL_LOGO_URL=

# Anti-abuso en enlace mágico (opcional / intercambiable · ADR-050):
# Usa "none" para operar sin Cloudflare Turnstile (también elimina challenges.cloudflare.com de la CSP).
PITCHLAB_CAPTCHA_PROVIDER=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Modo de cobro activo en Beta 1.0 ("transfer" = SPEI + cupones manuales; "stripe" = Stripe Checkout + Connect).
PITCHLAB_PAYMENTS_MODE=transfer
# Datos bancarios SPEI visibles al crear o consultar una solicitud de transferencia.
PITCHLAB_TRANSFER_BANK=
PITCHLAB_TRANSFER_BENEFICIARY=
PITCHLAB_TRANSFER_CLABE=
# Nota opcional con horarios o instrucciones adicionales para validar el comprobante SPEI.
PITCHLAB_TRANSFER_INSTRUCTIONS=

# Stripe MX: /api/webhooks/stripe (eventos de suscripción, cobro y reembolso).
# Crea el endpoint con la versión de API 2025-09-30.clover (la misma que fija stripe-api.ts) y
# suscríbelo a: customer.subscription.created/updated/deleted, invoice.paid,
# invoice.payment_failed, charge.refunded y checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Secreto del endpoint de Connect (eventos de cuentas de tipsters, p. ej. account.updated).
STRIPE_CONNECT_WEBHOOK_SECRET=
# Secreto Bearer con el que cualquier planificador HTTP (crontab, GitHub Actions, EventBridge, Cloud Scheduler, Vercel Cron) llama a /api/cron/*.
CRON_SECRET=
# Secreto HMAC para enlaces de baja en un clic de correos periódicos (si falta, usa BETTER_AUTH_SECRET).
UNSUBSCRIBE_SECRET=
# Web Push VAPID (PWA instalable en móvil y alertas en segundo plano). Genera un par P-256 base64url.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@pitchlab.mx
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# IDs de precio del Pase Total en Stripe (price_...): $299/mes y $2,390/año.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
# Cupón del amigo invitado: en Stripe, Cupón «$90 MXN de descuento» (amount_off=9000, currency=mxn,
# duration=once) para que su primer mes quede en $209. Se aplica solo en el plan mensual.
STRIPE_COUPON_REFERRAL=

# Correos con acceso a /app/admin (separados por coma).
PITCHLAB_ADMIN_EMAILS=

# Upstash Redis REST (limitador de tasa distribuido y atómico en /api/*; en desarrollo usa memoria).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Webhook HTTPS genérico de redespliegue tras cortes de datos en CI (compatible con cualquier hosting; respaldo legacy: VERCEL_DEPLOY_HOOK_URL).
DEPLOY_HOOK_URL=
VERCEL_DEPLOY_HOOK_URL=

# Facturapi (CFDI 4.0; módulo validado, se activa al conectar timbrado fiscal en cobro).
FACTURAPI_KEY=

# Cortex IA (análisis por secciones con LLM vía OpenRouter, ADR-013). Lo redacta el corte diario
# (`pnpm --filter @pitchlab/ingest cortex:write`), una vez por partido: va como secreto de GitHub
# Actions, no en Vercel (la ficha solo lee el snapshot). Sin clave no hay texto de IA.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Proveedor fijo de OpenRouter (los precios varían entre proveedores).
OPENROUTER_PROVIDER=

# Desarrollo local con rama aislada de Neon (scripts/local-9990.ps1 y scripts/migrate-9990.ps1).
NEON_PROJECT_ID=
NEON_DATABASE_NAME=neondb
