# Código de acceso de 4 dígitos para socios en el pre-MVP (comparación en tiempo constante en el servidor)
PITCHLAB_BETA_CODE=2026

# Secreto HMAC-SHA256 para firmar la cookie HttpOnly de acceso a la beta (mínimo 32 caracteres aleatorios en producción)
PITCHLAB_COOKIE_SECRET=reemplazar-con-secreto-aleatorio-de-32-caracteres-minimo

# Opcional: clave gratuita de API-Football (api-football.com) para habilitar Liga MX (máx. 100 solicitudes/día)
API_FOOTBALL_KEY=

# Opcional: clave gratuita de football-data.org (X-Auth-Token) para Premier League
FOOTBALL_DATA_API_KEY=
