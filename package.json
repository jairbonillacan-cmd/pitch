{
  "name": "pitchlab-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "node scripts/check-no-demo-prod.mjs && turbo run build && node scripts/lint-codebase.mjs",
    "dev": "turbo run dev",
    "test": "turbo run test && node scripts/lint-codebase.mjs",
    "lint": "turbo run lint && node scripts/lint-codebase.mjs",
    "typecheck": "turbo run typecheck",
    "snapshot": "pnpm --filter @pitchlab/ingest snapshot",
    "e2e": "pnpm --filter @pitchlab/web e2e",
    "storybook": "pnpm --filter @pitchlab/ui storybook",
    "build-storybook": "pnpm --filter @pitchlab/ui build-storybook"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
